# set-dns <adguard|cloudflare|opendns|off> <safesearch 0|1>
# Turning protection off (or SafeSearch off) is refused while anti-cheat is active.
cmd_set_dns() {
  local provider="${1:-}" safe="${2:-1}"
  case "$provider" in adguard|cloudflare|opendns|off) ;; *) die "uso: chronos-guard set-dns <adguard|cloudflare|opendns|off> <0|1>" ;; esac
  [ "$safe" = "0" ] || safe=1
  load_dns_conf
  if { [ "$DNS_PROVIDER" != "off" ] && [ "$provider" = "off" ]; } || { [ "$SAFESEARCH" = "1" ] && [ "$safe" = "0" ]; }; then
    assert_anti_cheat_inactive_for_uninstall
  fi
  install -d -m 0755 "$STORE"
  write_if_changed "$DNS_CONF" "$(printf 'DNS_PROVIDER="%s"\nSAFESEARCH=%s' "$provider" "$safe")" || true
  cmd_apply
}

# Private/incognito + guest browsing block (user or parents choose). Turning it on is
# passwordless; turning it off is refused while anti-cheat is active.
cmd_set_incognito() {
  local want="${1:-}"
  case "$want" in 0|1) ;; *) die "uso: chronos-guard set-incognito <0|1>" ;; esac
  load_conf
  if [ "${BLOCK_INCOGNITO:-1}" = "1" ] && [ "$want" = "0" ]; then
    assert_anti_cheat_inactive_for_uninstall
  fi
  install -d -m 0755 "$STORE"
  write_if_changed "$PRIVATE_CONF" "BLOCK_PRIVATE=$want" || true
  cmd_apply
}

# ---------------------------------------------------------------- parental account
# A child account in wheel/sudo can remove the guard as root. Protecting it removes the
# admin groups (saved for undo) and allows, through polkit, only everyday actions: Wi-Fi,
# USB drives, printers, Bluetooth, power, time zone and installing signed packages from
# the official repositories. Needs another admin account (the guardian's), so root access
# is never lost; the default polkit action asks for that admin's password.
PARENTAL_DIR="/var/lib/chronos/parental"
PARENTAL_RULES="/etc/polkit-1/rules.d/48-chronos-parental.rules"
ADMIN_GROUPS="wheel sudo admin"

admin_members_except() {
  local skip="$1" g u
  for g in $ADMIN_GROUPS; do
    for u in $(getent group "$g" | cut -d: -f4 | tr ',' ' '); do
      [ "$u" != "$skip" ] && echo "$u"
    done
  done | sort -u
}

write_parental_rules() {
  local users=() f
  for f in "$PARENTAL_DIR"/*.groups; do
    [ -f "$f" ] && users+=("\"$(basename "$f" .groups)\"")
  done
  if [ "${#users[@]}" -eq 0 ]; then
    rm -f "$PARENTAL_RULES"
    return 0
  fi
  local list
  list="$(IFS=,; echo "${users[*]}")"
  install -d -m 0755 /etc/polkit-1/rules.d
  cat > "$PARENTAL_RULES" <<EOF
// Chronos parental mode: everyday actions for protected (non-admin) accounts.
polkit.addRule(function(action, subject) {
  if ([$list].indexOf(subject.user) < 0 || !subject.local || !subject.active) {
    return polkit.Result.NOT_HANDLED;
  }
  var id = action.id;
  var allowed = [
    "org.freedesktop.NetworkManager.network-control",
    "org.freedesktop.NetworkManager.enable-disable-wifi",
    "org.freedesktop.NetworkManager.enable-disable-network",
    "org.freedesktop.NetworkManager.wifi.scan",
    "org.freedesktop.NetworkManager.settings.modify.own",
    "org.freedesktop.udisks2.filesystem-mount",
    "org.freedesktop.udisks2.filesystem-mount-other-seat",
    "org.freedesktop.udisks2.eject-media",
    "org.freedesktop.udisks2.power-off-drive",
    "org.freedesktop.login1.power-off",
    "org.freedesktop.login1.reboot",
    "org.freedesktop.login1.suspend",
    "org.freedesktop.login1.hibernate",
    "org.freedesktop.timedate1.set-timezone",
    "org.freedesktop.packagekit.package-install",
    "org.freedesktop.packagekit.system-update",
    "org.freedesktop.packagekit.system-sources-refresh"
  ];
  if (allowed.indexOf(id) >= 0 || id.indexOf("org.opensuse.cupspkhelper.mechanism.") === 0 || id.indexOf("org.bluez.") === 0) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
EOF
  chmod 0644 "$PARENTAL_RULES"
}

cmd_protect_account() {
  local user="${1:-}" want="${2:-}"
  [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "uso: chronos-guard protect-account <usuário> <0|1>"
  case "$want" in 0|1) ;; *) die "uso: chronos-guard protect-account <usuário> <0|1>" ;; esac
  id "$user" >/dev/null 2>&1 || die "usuário inexistente: $user"
  [ "$user" != "root" ] || die "a conta root não pode ser protegida"
  install -d -m 0755 "$PARENTAL_DIR"
  local saved="$PARENTAL_DIR/$user.groups" g
  if [ "$want" = "1" ]; then
    [ -n "$(admin_members_except "$user")" ] || die "nenhuma outra conta de administrador. Crie a conta do responsável (com sudo) antes de proteger esta, ou o computador ficaria sem administrador."
    local removed=""
    for g in $ADMIN_GROUPS; do
      if id -nG "$user" | tr ' ' '\n' | grep -qx "$g"; then
        gpasswd -d "$user" "$g" >/dev/null && removed="$removed $g"
      fi
    done
    # Re-applying keeps the groups saved the first time.
    [ -f "$saved" ] || { printf '%s\n' "${removed# }" > "$saved"; chmod 0644 "$saved"; }
    write_parental_rules
    echo "chronos-guard: conta $user protegida (grupos removidos:${removed:- nenhum}). Vale no próximo login."
  else
    if [ -f "$saved" ]; then
      for g in $(cat "$saved"); do
        getent group "$g" >/dev/null && gpasswd -a "$user" "$g" >/dev/null || true
      done
      rm -f "$saved"
    fi
    write_parental_rules
    echo "chronos-guard: proteção da conta $user removida."
  fi
}

cmd_uninstall() {
  assert_anti_cheat_inactive_for_uninstall
  if [ -x "$VAULT_BIN" ] && [ -n "${TARGET_USER:-}" ]; then
    "$VAULT_BIN" uninstall --user "$TARGET_USER" || die "Anti-Cheat ativo (cofre do Chronos)."
  fi
  rm -rf /var/lib/chronos
  rm -f /usr/share/polkit-1/actions/org.chronos.vault.policy
  rm -f "$RESOLVED_DROPIN" "$NM_DROPIN" "$DNS_CONF" "$PRIVATE_CONF"
  systemctl reload NetworkManager 2>/dev/null || true
  systemctl restart systemd-resolved 2>/dev/null || true
  systemctl disable --now chronos-guard.service 2>/dev/null || true
  rm -f /etc/systemd/system/chronos-guard.service
  for entry in "${BROWSERS[@]}"; do rm -f "${entry%%|*}/$POLICY_NAME"; done
  for entry in "${FIREFOX_BROWSERS[@]}"; do rm -f "${entry%%|*}/policies.json"; done
  # Give protected accounts their admin groups back (the polkit rules go away too).
  local pf
  for pf in "$PARENTAL_DIR"/*.groups; do
    [ -f "$pf" ] && cmd_protect_account "$(basename "$pf" .groups)" 0 || true
  done
  rm -f "$PARENTAL_RULES"
  rm -f "$SNAP_FF_DIR"/chronos-proxy-ca.crt "$SNAP_FF_DIR"/chronos-proxy.pac "$SNAP_FF_DIR"/chronos-*.xpi
  cleanup_legacy_user_firefox_policies
  rm -f "$ARCH_CA_ANCHOR" "$DEBIAN_CA_ANCHOR"
  command -v trust >/dev/null 2>&1 && trust extract-compat >/dev/null 2>&1 || true
  command -v update-ca-certificates >/dev/null 2>&1 && update-ca-certificates >/dev/null 2>&1 || true
  rm -f /etc/polkit-1/rules.d/49-chronos-guard.rules
  rm -f /usr/share/polkit-1/actions/org.chronos.guard.policy
  rm -f /usr/local/bin/chronos-guard
  rm -rf "$STORE" /usr/local/lib/chronos
  systemctl daemon-reload 2>/dev/null || true
  echo "chronos-guard: removido completamente."
}

case "${1:-}" in
  apply)      cmd_apply "${2:-}" ;;
  update-crx) cmd_update_crx "${2:-}" "${3:-}" ;;
  update-ca)  cmd_update_ca "${2:-}" "${3:-}" ;;
  set-dns)    cmd_set_dns "${2:-}" "${3:-1}" ;;
  set-incognito) cmd_set_incognito "${2:-}" ;;
  watch)      cmd_watch ;;
  status)     cmd_status ;;
  protect-account) cmd_protect_account "${2:-}" "${3:-}" ;;
  uninstall)  cmd_uninstall ;;
  *) echo "uso: chronos-guard {apply|update-crx <crx> <versão>|update-ca <ca.crt> <proxy.pac>|watch|status|uninstall}" >&2; exit 2 ;;
esac
